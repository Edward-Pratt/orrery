// `pnpm lint`: oxlint with its type-aware rules (oxlint-tsgolint), docs/notes/hardening.md §9. The gate is for promises
// nobody awaits or that a void callback drops, in a bot that runs for weeks. hub/.oxlintrc.json is the same.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "eslint", "node"],
  "categories": { "correctness": "error" },
  "rules": {
    "typescript/no-floating-promises": [
      "error",
      { "allowForKnownSafeCalls": [{ "from": "package", "package": "node:test", "name": ["test", "it", "describe", "suite"] }] }
    ],
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "arguments": true, "attributes": true } }],
    // A `default:` that handles the rest (forwards it, or names what it ignores) counts; a switch without one must list every case.
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],

    // Off: each hit was intended code.
    "typescript/restrict-template-expressions": "off", // numbers, unions and unknowns in messages, on purpose
    "typescript/no-base-to-string": "off", // the same, through `String()`
    "typescript/require-await": "off", // async to fit a Promise-typed slot, or so a throw is a rejection
    "typescript/require-array-sort-compare": "off", // sorts of strings, and of 3-digit statuses in tests
    "typescript/no-misused-spread": "off", // `[...text]` splits by code point on purpose
    "typescript/no-meaningless-void-operator": "off", // `return void f()`: the house idiom for "return after this"
    "typescript/unbound-method": "off", // tests keep a prototype's method to wrap it
    "no-control-regex": "off" // the wire's checks and the moderation filter match control characters on purpose
  }
}
