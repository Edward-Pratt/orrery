# GTNH server. Console: type with `echo "<command>" > /run/gtnh.stdin`, read with `journalctl -u gtnh -f`.
# (No tmux: SELinux on RHEL/Oracle Linux doesn't let services start tmux.)
# Install: sudo cp deploy/gtnh.service deploy/gtnh.socket /etc/systemd/system/
# Edit User, WorkingDirectory and the start script to match your server (and SocketUser in gtnh.socket).
#
# Restart=always because a 1.7.10 server exits with code 0 even after a crash, so on-failure would miss it:
#   crash / kill -9      -> restarts after 10 s
#   in-game /stop        -> restarts (a handy restart button, also via /cmd stop from Discord)
#   systemctl stop gtnh  -> stays down (use this for maintenance)
[Unit]
Description=GTNH server
After=network-online.target gtnh-hub.service gtnh.socket
Wants=network-online.target
Requires=gtnh.socket

[Service]
User=opc
WorkingDirectory=/home/opc/GTNH
# Run the script through bash (not directly) so SELinux doesn't block executing a file in /home.
ExecStart=/bin/bash ./startserver-java9.sh
StandardInput=socket
StandardOutput=journal
StandardError=journal
# `stop` saves and runs every mod's shutdown handler; then wait for the JVM to exit.
ExecStop=/bin/sh -c 'echo stop > /run/gtnh.stdin; while kill -0 $MAINPID 2>/dev/null; do sleep 2; done'
# GTNH world saves can take minutes; the 90 s default would SIGKILL mid-save and risk corruption.
TimeoutStopSec=600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
