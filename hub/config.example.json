      "lagMinutes": 2,
      "quests": "batched"
    }
  ],
  "integrations": {
    "minecraft": {
      "listenPort": 25580,
      "tokens": { "gtnh": "CHANGE_ME_TO_A_LONG_RANDOM_STRING" }
    },
    "discord": {
      "guildId": "YOUR_DISCORD_SERVER_ID",
      "adminRoleId": "ROLE_ID_ALLOWED_TO_USE_CMD",
      "channels": { "gtnh": "CHANNEL_ID_FOR_THIS_SERVER" },
      "alertsChannel": "CHANNEL_ID_FOR_HOST_SERVICE_AND_CHECK_ALERTS"
    },
    "host": { "id": "oracle", "mounts": ["/"], "memoryMaxPercent": 90, "memoryMinutes": 5, "diskMinFreeGB": 10 },
    "systemd": [
      { "id": "gtnh", "unit": "gtnh.service" },
      { "id": "caddy", "unit": "caddy.service" }
    ],
    "checks": [
      { "id": "dashboard", "url": "https://dash.orrery.run", "intervalSeconds": 60, "service": "caddy" }
    ],
    "web": {
      "listenPort": 25581,
      "publicUrl": "https://dash.orrery.run",
      "clientId": "YOUR_DISCORD_OAUTH_APP_ID",
      "sessionDays": 7
    }
