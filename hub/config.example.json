{
  "dbPath": "hub.db",
  "healthcheckUrl": "https://hc-ping.com/YOUR-CHECK-UUID",
  "servers": [
    {
      "id": "gtnh",
      "name": "GTNH",
      "dir": "/home/opc/GTNH",
      "dailyRestart": "06:00",
      "dailySummary": "09:00",
