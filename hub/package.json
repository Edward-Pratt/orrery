{
  "name": "orrery-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p tsconfig.api.json",
    "lint": "oxlint --type-aware --deny-warnings src test",
    "check-config": "node src/check-config.ts",
    "users": "node src/users-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "discord.js": "^14.28.1",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.21.0"
}
